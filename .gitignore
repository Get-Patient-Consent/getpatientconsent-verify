report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Python virtualenvs (e.g. datasets-derived helper scripts)
.venv/
**/.venv/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
# Root .env.shared holds the values app/ and admin-api/ must agree on (Redis,
# ALERT_SECRET_KEY, Telegram, Stripe) — real secrets, never committed. Its
# template is, and needs its own negation: `!.env.example` doesn't match it.
!.env.shared.example
# Same trap, same fix: app/.env.test holds the integration tier's throwaway
# credentials (app/test/integration/README.md). `.env.*` swallows the template
# too, and a template that is silently never committed is worse than none —
# everyone but the author gets a missing file and no clue what belongs in it.
!.env.test.example

# signing key material — NEVER commit private keys
.secrets/
**/.secrets/
*.private.pem
*.private.env

# Local leaflet PDF storage (swap for object storage in serverless deployments)
local-data/

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

